<Window x:Class="Apagado.Servidor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apagado Remoto - Servidor" Height="820" Width="1120" MinHeight="700" MinWidth="980">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtSelectionCount" Text="0 seleccionados" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="DimGray"/>
                <TextBlock Text="Ctrl o Shift para seleccionar varios" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAdd" Width="120" Height="30" Margin="0,0,6,0" Click="BtnAdd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Añadir" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnRemove" Width="120" Height="30" Margin="0,0,6,0" Click="BtnRemove_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnDiscover" Width="160" Height="30" Click="BtnDiscover_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Buscar clientes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <GroupBox Header="Clientes" Grid.Row="1" Margin="0,0,0,6" MinHeight="220">
            <ListView x:Name="lstTargets" SelectionMode="Extended" SelectionChanged="LstTargets_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Equipo" Width="220" DisplayMemberBinding="{Binding MachineName}"/>
                        <GridViewColumn Header="Dirección" Width="170" DisplayMemberBinding="{Binding Address}"/>
                        <GridViewColumn Header="Versión" Width="90" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="Último estado" Width="390" DisplayMemberBinding="{Binding LastStatus}"/>
                        <GridViewColumn Header="Actualizado" Width="180" DisplayMemberBinding="{Binding LastUpdatedDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <TabControl Grid.Row="2" Height="240" Margin="0,0,0,6">
            <TabItem Header="Encendido">
                <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Aplica la acción a todos los clientes seleccionados." Foreground="Gray" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <TextBlock Text="Retraso (segundos):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtDelay" Text="60" Width="80" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnShutdown" Width="150" Height="34" Margin="0,0,8,0" Click="BtnShutdown_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Apagar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnReboot" Width="150" Height="34" Margin="0,0,8,0" Click="BtnReboot_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Reiniciar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCancelShutdown" Width="180" Height="34" Click="BtnCancelShutdown_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancelar apagado" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Bloqueo">
                <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Muestra un aviso a pantalla completa en los clientes seleccionados." Foreground="Gray" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mensaje de bloqueo:" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtLockMessage" Grid.Column="0" Text="Ud. ha infringido el reglamento. Para continuar, contacte al administrador." VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="6,4"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnLock" Width="150" Height="34" Margin="0,0,8,0" Click="BtnLock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Bloquear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnUnlock" Width="160" Height="34" Click="BtnUnlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Desbloquear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Avisos">
                <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Envía un aviso que el usuario deberá aceptar para continuar trabajando." Foreground="Gray" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Título:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtNoticeTitle" Text="Aviso del administrador" Width="620" MaxLength="120" VerticalContentAlignment="Center" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Mensaje:" VerticalAlignment="Top" Margin="0,6,6,0"/>
                        <TextBox x:Name="txtNoticeMessage" Width="620" Height="70" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6,4"/>
                    </StackPanel>
                    <Button x:Name="btnSendNotice" Width="190" Height="34" HorizontalAlignment="Center" Click="BtnSendNotice_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Enviar aviso" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>

            <TabItem Header="Fondo de escritorio">
                <Grid Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Height="150" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="imgPreview" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button x:Name="btnSelectImage" Width="190" HorizontalAlignment="Left" Click="BtnSelectImage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Seleccionar imagen..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Estilo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbStyle" Width="150">
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Tile"/>
                                <ComboBoxItem Content="Stretch"/>
                                <ComboBoxItem Content="Fit"/>
                                <ComboBoxItem Content="Fill"/>
                                <ComboBoxItem Content="Span"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="btnSetWallpaper" Width="270" Height="36" Margin="0,14,0,0" HorizontalAlignment="Left" Click="BtnSetWallpaper_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Aplicar fondo a los seleccionados" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Actualización">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Paquete:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtUpdatePackage" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6,4"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="btnSelectUpdatePackage" Content="Seleccionar..." Width="120" Margin="6,0,0,0" Click="BtnSelectUpdatePackage_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Versión:" VerticalAlignment="Center" Margin="0,8,6,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtUpdateVersion" VerticalContentAlignment="Center" Padding="6,4" Margin="0,8,0,0"/>
                    <Button Grid.Row="1" Grid.Column="2" x:Name="btnRefreshVersions" Content="Verificar versiones" Width="150" Margin="6,8,0,0" Click="BtnRefreshVersions_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256:" VerticalAlignment="Center" Margin="0,8,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtUpdateSha256" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6,4" Margin="0,8,0,0"/>
                    <Button Grid.Row="2" Grid.Column="2" x:Name="btnUpdateClients" Content="Actualizar clientes" Width="150" Margin="6,8,0,0" Click="BtnUpdateClients_Click"/>

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="Se envía el instalador del cliente a los equipos seleccionados. La instalación es silenciosa y el listener se reinicia automáticamente." Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Conexión">
                <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Datos usados para comunicarse con los clientes." Foreground="Gray" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <TextBlock Text="Token:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtToken" Text="clave-compartida-aqui" Width="300" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Puerto por defecto:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPort" Text="5007" Width="90" VerticalContentAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <GroupBox Header="Historial / Log" Grid.Row="3">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
